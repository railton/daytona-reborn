msgid "This server asks for a password."
msgstr "Este servidor pede uma senha."

msgid "Invalid server address: an IP or name, with :port if it is not 7777."
msgstr "Endereço do servidor inválido: um IP ou nome, com :porta se não for 7777."

msgid "Room settings"
msgstr "Configurações da sala"

msgid "Every player of the room races with these settings. They are kept for your next room."
msgstr "Todos os jogadores da sala correm com estas configurações. Elas ficam guardadas para a sua próxima sala."

msgid "Server (IP or DNS)"
msgstr "Servidor (IP ou DNS)"

msgid "Connect again"
msgstr "Conectar de novo"

msgid "Connect"
msgstr "Conectar"

msgid "Server password"
msgstr "Senha do servidor"

msgid "Connecting to %s..."
msgstr "Conectando a %s..."

msgid "Type your name above to connect to the server."
msgstr "Digite seu nome acima para conectar ao servidor."

msgid "This server already races with a newer version of the game: update yours (git pull, or download the source again, and build it again) to play with its players."
msgstr "Este servidor já tem corridas com uma versão mais nova do jogo: atualize a sua (git pull, ou baixe o código de novo, e compile outra vez) para jogar com os jogadores dele."

msgid "Connected to %s: choose the room's settings."
msgstr "Conectado a %s: escolha as configurações da sala."

msgid "Connect to the server to choose the room's settings."
msgstr "Conecte-se ao servidor para escolher as configurações da sala."

msgid "Race settings"
msgstr "Configurações da corrida"

msgid "Create the room"
msgstr "Criar a sala"

msgid "Room"
msgstr "Sala"

msgid "Copy"
msgstr "Copiar"

msgid "(you)"
msgstr "(você)"

msgid "Next race:"
msgstr "Próxima corrida:"

msgid "Latency to the server, round trip; between two players it is about the sum."
msgstr "Latência até o servidor, ida e volta; entre dois jogadores é mais ou menos a soma."

msgid "New race with everyone"
msgstr "Nova corrida com todos"

msgid "Waiting for the race"
msgstr "Aguardando a corrida"

msgid " (you)"
msgstr " (você)"

msgid "STANDINGS"
msgstr "CLASSIFICAÇÃO"

msgid "PLAYERS"
msgstr "JOGADORES"

msgid "%d."
msgstr "%dº"

msgid " on a %.2f Hz display"
msgstr " em uma tela de %.2f Hz"

msgid "cabinet speed, 57.52 frames/s%s"
msgstr "velocidade do arcade, 57,52 quadros/s%s"

msgid "at every refresh"
msgstr "a cada atualização"

msgid "every %d refreshes"
msgstr "a cada %d atualizações"

msgid ", speed %+.1f %%"
msgstr ", velocidade %+.1f %%"

msgid "locked, %.2f frames/s, one frame %s%s%s"
msgstr "sincronizado, %.2f quadros/s, um quadro %s%s%s"

msgid "VRR, 57.52 frames/s, each held 17.38 ms%s"
msgstr "VRR, 57,52 quadros/s, cada um por 17,38 ms%s"

msgid "This room does not exist: is the code complete? Is its creator still connected?"
msgstr "Esta sala não existe: o código está completo? Quem criou ainda está conectado?"

msgid "This room already exists."
msgstr "Esta sala já existe."

msgid "This room is full."
msgstr "Esta sala está cheia."

msgid "This room is not for that number of players."
msgstr "Esta sala não é para esse número de jogadores."

msgid "Wrong server password."
msgstr "Senha do servidor incorreta."

msgid "The server is full: too many rooms open."
msgstr "O servidor está cheio: salas abertas demais."

msgid "Too many connections to the server from your address."
msgstr "Conexões demais com o servidor a partir do seu endereço."

msgid "This server runs a newer version of the Online mode: update your game (git pull, or download the source again) and build it again."
msgstr "Este servidor usa uma versão mais nova do modo Online: atualize o seu jogo (git pull, ou baixe o código de novo) e compile outra vez."

msgid "This server runs an older version of the Online mode: whoever runs it needs to update it."
msgstr "Este servidor usa uma versão mais antiga do modo Online: quem cuida dele precisa atualizá-lo."

msgid "This server is not compatible with this version of the game."
msgstr "Este servidor não é compatível com esta versão do jogo."

msgid "Invalid room code."
msgstr "Código de sala inválido."

msgid "Invalid number of players: 2 to 8."
msgstr "Número de jogadores inválido: de 2 a 8."

msgid "The server refused the room's settings."
msgstr "O servidor recusou as configurações da sala."

msgid "This room belongs to the daytona-link helper, not to the game's Online mode."
msgstr "Esta sala pertence ao utilitário daytona-link, não ao modo Online do jogo."

msgid "Too many rooms open from your address."
msgstr "Muitas salas abertas a partir do seu endereço."

msgid "Too many failed attempts: wait a minute and try again."
msgstr "Muitas tentativas sem sucesso: espere um minuto e tente de novo."

msgid "The room was closed: nobody raced in it for a long time."
msgstr "A sala foi fechada: ninguém correu nela por muito tempo."

msgid "Disconnected by the server: your game sent too much data."
msgstr "Desconectado pelo servidor: seu jogo enviou dados demais."

msgid "This room was created by a newer version of the game: update yours (git pull, or download the source again, and build it again) to join it."
msgstr "Esta sala foi criada por uma versão mais nova do jogo: atualize a sua (git pull, ou baixe o código de novo, e compile outra vez) para entrar nela."

msgid "This room was created by an older version of the game: its creator needs to update to the latest version."
msgstr "Esta sala foi criada por uma versão mais antiga do jogo: quem a criou precisa atualizar para a versão mais recente."

msgid "This room was created by another version of the game: every player needs the same version."
msgstr "Esta sala foi criada por outra versão do jogo: todos os jogadores precisam ter a mesma versão."

msgid "The server refused the connection: "
msgstr "O servidor recusou a conexão: "

msgid "Invalid server address."
msgstr "Endereço do servidor inválido."

msgid "Server not found: "
msgstr "Servidor não encontrado: "

msgid "Cannot connect to the server (is it running? is its port open?): "
msgstr "Não foi possível conectar ao servidor (ele está ligado? a porta está aberta?): "

msgid "Connection to the server lost."
msgstr "Conexão com o servidor perdida."

msgid "The server stopped answering."
msgstr "O servidor parou de responder."

msgid "The connection to the server is too slow."
msgstr "A conexão com o servidor está lenta demais."

msgid "Invalid answer from the server."
msgstr "Resposta inválida do servidor."

msgid "The game is not reading the data it receives."
msgstr "O jogo não está lendo os dados recebidos."

msgid "Invalid data from another player: is everyone on the same version of the game?"
msgstr "Dados inválidos de outro jogador: todos estão com a mesma versão do jogo?"
