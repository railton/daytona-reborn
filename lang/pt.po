msgstr "Senha do servidor (opcional)"

msgid "Players"
msgstr "Jogadores"

msgid "Create the room"
msgstr "Criar a sala"

msgid "Invalid server address: an IP or name, with :port if it is not 7777."
msgstr "Endereço do servidor inválido: um IP ou nome, com :porta se não for 7777."

msgid "Join a room"
msgstr "Entrar numa sala"

msgid "Invite code"
msgstr "Código de convite"

msgid "Paste"
msgstr "Colar"

msgid "Join"
msgstr "Entrar"

msgid "Invalid invite code: copy all of it, it starts with DTN1."
msgstr "Código de convite inválido: copie o código inteiro, ele começa com DTN1."

msgid "The code already holds the server, the room and the password."
msgstr "O código já contém o servidor, a sala e a senha."

