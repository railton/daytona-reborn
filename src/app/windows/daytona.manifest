<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The game's Windows manifest: the process's code page is UTF-8 (Windows 10
     1903 and later), so every file path the game opens may hold accents or
     other non-ASCII letters (a ROM set in "Área de Trabalho", a user named
     "João"): the game keeps its paths in UTF-8 everywhere. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
